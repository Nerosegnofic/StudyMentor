<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for DATA_SYNC foreground service type on Android 14+ (API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <!-- Required to enumerate installed apps on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Required to reschedule WorkManager tasks after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required to post notifications on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Required to prompt the user to add this app to the battery-optimisation
        whitelist via Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS.
        Without this declaration the direct-intent path in PermissionPlugin
        will throw ActivityNotFoundException on most devices.
        tools:ignore suppresses the Play Store lint warning — this app is
        distributed outside the Play Store so the policy does not apply.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <application
        android:label="StudyMentor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
            Background usage timer foreground service.
            • foregroundServiceType="dataSync" satisfies Android 14 (API 34)
              requirements and is supported down to Android 10 (API 29).
            • exported="false" — only started from within the app.
            • START_STICKY ensures the OS restarts it after a process kill.
        -->
        <service
            android:name=".UsageTimerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".StudyMentorAccessibilityService"
            android:exported="true"
            android:label="StudyMentor"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Device Admin receiver.
            • BIND_DEVICE_ADMIN permission ensures only the system can talk to it.
            • The device_admin.xml policy file declares which policies we use
              (currently none — just being a device admin prevents uninstall).
            • exported="true" is required by the Device Admin API.
        -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Marks the installed-app inventory as stale whenever the student
             installs or uninstalls an app, even while StudyMentor is closed.
             Flutter reads and clears this flag on every app resume. -->
        <receiver
            android:name=".PackageChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!--
            Boot receiver — restarts background services when the device boots.

            Why exported="false" with a direct-boot-aware flag is NOT used here:
            We depend on SharedPreferences (credential-encrypted storage) to read
            KEY_STUDENT_MODE, which is only available after the user unlocks the
            device. ACTION_BOOT_COMPLETED fires after first unlock, which is
            exactly when our prefs are readable, so direct-boot is unnecessary.

            directBootAware="false" is the default and is stated explicitly for
            clarity. If you later migrate prefs to device-protected storage you
            can flip this to true and add LOCKED_BOOT_COMPLETED to the filter.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <!-- Fires after the device fully boots and the user unlocks
                     for the first time (credential-encrypted storage is ready). -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Fires on Android 7+ after a "quick boot" / soft reboot
                     once the user profile is unlocked. Covers factory resets
                     and OEM fast-boot implementations. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HTC / some MediaTek OEMs use a different action name for
                     the same quick-boot event. Belt-and-suspenders coverage. -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>